{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoSub",
  "version": "0.3.0",
  "identifier": "com.echosub.app",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "EchoSub",
        "url": "index.html",
        "width": 1100,
        "height": 170,
        "minWidth": 320,
        "minHeight": 60,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
